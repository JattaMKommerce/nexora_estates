# Hannah's API folder: only hannah.php may be reached from the web.
Options -Indexes

<IfModule mod_authz_core.c>
    Require all denied
    <Files "hannah.php">
        Require all granted
    </Files>
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
    <Files "hannah.php">
        Allow from all
    </Files>
</IfModule>
